DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=

# Optionnel : bascule vers PostgreSQL (ou autre) en prod. Laisser vide pour SQLite en local.
# ex: DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=

# Email : backend console par défaut (les emails s'affichent dans le terminal).
# Pour un vrai envoi SMTP, décommenter et renseigner :
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.gmail.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=noreply@omnews.ml
